# Copy to .env and fill in only the providers/methods you intend to run.
CLEANBENCH_API_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://your-compatible-endpoint/v1
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2025-03-01-preview

CLEANBENCH_MODEL_GPT41=gpt-4.1
CLEANBENCH_MODEL_GPT52=gpt-5.2
CLEANBENCH_MODEL_GPT55=gpt-5.5
CLEANBENCH_MODEL_ASTRA=gpt-6-astra
CLEANBENCH_MODEL_WORKFLOWS=gpt-4o-2024-11-20
CLEANBENCH_MODEL_CODEX=gpt-6-astra
CLEANBENCH_MODEL_COPILOT=gpt-6-astra

# CODEX_API_KEY=
# COPILOT_GITHUB_TOKEN=
# OPENAI_API_KEY_FILE=/absolute/path/to/key.txt
# CLEANBENCH_RULES_FILE=/absolute/path/to/constraint_rules.json
